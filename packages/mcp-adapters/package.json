{
  "name": "@desaignsync/mcp-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adapters that translate raw MCP servers (Chrome DevTools, Design System, Storybook) into internal contracts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
