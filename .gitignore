# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
.tsbuild/
.vite/

# Test / coverage
coverage/
.nyc_output/

# Local runtime state (never commit host runtime files or secrets)
.desaignsync/
.runtime/
*.local.json

# Secrets & env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Compiled leftovers inside tests/fixtures (*.mjs fixtures are hand-written and stay tracked)
tests/fixtures/*.js
tests/fixtures/*.js.map
tests/fixtures/*.d.ts
tests/fixtures/*.d.ts.map
